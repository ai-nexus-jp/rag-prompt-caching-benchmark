# ==========================================
# LLM API Keys
# ==========================================
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# ==========================================
# Target Models (Default Settings - Updated 2026-10-28)
# ==========================================
# Anthropic: claude-sonnet-5-5 (推奨フラグシップ / または claude-opus-5-5 / claude-haiku-5-5 / claude-fable-5-1)
DEFAULT_ANTHROPIC_MODEL="claude-sonnet-5-5"

# OpenAI: gpt-6.1-sol (推奨フラグシップ / または gpt-6-luna / gpt-6.1-terra / gpt-6-astra)
DEFAULT_OPENAI_MODEL="gpt-6.1-sol"

# Google: gemini-3.8-flash (推奨フラグシップ / または gemini-4-argon / gemini-3.1-pro-preview / gemini-3.5-flash-lite)
DEFAULT_GEMINI_MODEL="gemini-3.8-flash"

# ==========================================
# Benchmark Default Config
# ==========================================
DEFAULT_TURNS=5
DEFAULT_DELAY_SECONDS=1.5
OUTPUT_DIR="./results"
